FLASK_ENV=production
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

T5_MODEL_NAME=valhalla/t5-small-qg-hl
BERT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# t2.micro = 1 GB RAM. Set to false only with >= 2 GB RAM (e.g. t3.small+)
DISABLE_T5_MODEL=true

# ==============================================================================
# Modern LLM Provider Configuration
# Set at least one API key below for instruction-tuned question generation & grading.
# If no key is set, the system gracefully uses high-quality offline templates.
# ==============================================================================
DEFAULT_LLM_MODEL=gemini/gemini-2.0-flash
# DEFAULT_LLM_MODEL=openai/gpt-4o-mini
# DEFAULT_LLM_MODEL=groq/llama-3.3-70b-versatile
# DEFAULT_LLM_MODEL=deepseek/deepseek-chat
# DEFAULT_LLM_MODEL=ollama/llama3

# API Keys (set the one corresponding to your model choice):
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Prevents HuggingFace tokenizer deadlock in threaded gunicorn
TOKENIZERS_PARALLELISM=false
PYTHONUNBUFFERED=1

